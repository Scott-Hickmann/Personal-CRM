{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relationship_id",
    "relationship_type",
    "confidence",
    "evidence_message_ids",
    "evidence"
  ],
  "properties": {
    "relationship_id": {
      "type": "string",
      "const": "__RELATIONSHIP_ID__"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "partner",
        "parent-child",
        "sibling",
        "relative",
        "friend",
        "coworker",
        "professional",
        "neighbor",
        "classmate",
        "unclear"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_message_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["__MESSAGE_ID__"]
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "evidence": {
      "type": "string",
      "maxLength": 300
    }
  }
}
